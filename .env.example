# Notion Copilot — variáveis de ambiente
# Copie para .env com permissão 600: cp .env.example .env && chmod 600 .env
# Nenhum valor real entra neste arquivo nem no repositório (RNF-S6).

# Token da integração do Notion (começa com "secret_" ou "ntn_").
# A integração precisa das capabilities Read content, Update content e
# Insert comments habilitadas (research R1/R6).
NOTION_TOKEN=

# ID do banco do inbox (32 caracteres hex, ou o ID que aparece na URL do banco).
NOTION_DATABASE_ID=

# ID da usuária no Notion — usado nas menções dos comentários (FR-014).
NOTION_USER_ID=

# Credencial do modelo Z.ai. Nome confirmado na máquina da usuária (research R5).
# Passada SOMENTE ao subprocesso claude, nunca como variável global (RNF-S6).
# A mesma chave autentica os MCPs de busca via ${ANTHROPIC_AUTH_TOKEN} no .mcp.json.
ANTHROPIC_AUTH_TOKEN=

# Endpoint do modelo (ADR-004: Z.ai). Valor fixo — não é segredo.
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# Modelo do agente (research R5: flag --model).
CLAUDE_MODEL=glm-5.3
